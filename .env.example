# في ظلال القرآن — environment variables
# Copy to `.env.local` for local development. All secrets stay server-side; never commit `.env.local`.

# --- Supabase (required for user-data cloud sync) ---
# Server-side only. The service_role key must NEVER reach the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
# Canonical origin used for metadata (canonical/OG), sitemap.xml and robots.txt.
# For Vercel, best set the production alias (e.g. https://fi-thila2.vercel.app).
# If unset, the app falls back to Vercel's VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL.
SITE_URL=

# --- Next.js (optional) ---
# NODE_ENV=production       # set automatically by the platform in production
# VERCEL_URL                # auto-injected by Vercel; not needed manually
